{
  "name": "hugo-clean-starter",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "css:build": "tailwindcss -i ./assets/css/main.css -o ./static/css/site.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/main.css -o ./static/css/site.css --watch",
    "dev": "npm run css:build && hugo server -D --disableFastRender",
    "build": "npm run css:build && hugo --minify"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19"
  }
}
