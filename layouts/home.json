{{- $items := slice -}}{{- range where site.RegularPages "Params.hidden" "ne" true -}}{{- $items = $items | append (dict "title" .Title "url" .RelPermalink "summary" (.Summary | plainify | truncate 260) "content" (.Plain | truncate 10000) "categories" (.Params.categories | default "") "tags" (.Params.tag | default (slice)) "date" (.Date.Format "2006-01-02")) -}}{{- end -}}{{ $items | jsonify }}